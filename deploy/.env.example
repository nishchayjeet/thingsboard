# Copy this file to `.env` (or to `~/.tb-deploy.env`) and fill in real values.
# .env is gitignored so secrets stay off the repo.
#
# Used by:
#   - pefeatures-build.sh (CI/CD: builds on Mac, ships to remote)
#   - dev-run.sh         (local app dev pointing at remote services)

# -------- Remote test server (192.168.69.16) ---------------------------------

TB_DEPLOY_HOST=192.168.69.16
TB_DEPLOY_USER=container
TB_DEPLOY_PATH=/home/container/thingsboard

# Auth — pick ONE. SSH key is strongly preferred.
# TB_DEPLOY_KEY=/Users/you/.ssh/id_ed25519
# TB_DEPLOY_PASSWORD=...      # requires `sshpass` (brew install hudochenkov/sshpass/sshpass)

TB_IMAGE_TAG=thingsboard/tb-node:pe-local

# -------- Mac-side local development (app on Mac, Postgres on remote) --------

# Spring Boot picks these up directly from the environment.
SPRING_DATASOURCE_URL=jdbc:postgresql://192.168.69.16:55432/thingsboard
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Bind only to localhost when running on Mac (so we don't expose to the LAN).
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# Disable embedded queue + use in-memory (no Kafka needed for development).
TB_QUEUE_TYPE=in-memory

# Run mode: when starting against a fresh remote Postgres, set INSTALL_TB=true once.
INSTALL_TB=false
LOAD_DEMO=false

# -------- Optional: report generator (only if running ReportRunner locally) --

REPORT_CHROME_BINARY=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
REPORT_BASE_URL=http://localhost:8080
